#!/bin/sh
# Stamp every commit on a work branch with its Plane ticket:  Plane: ASTERION-12
#
# The ticket comes from the branch name (fix/ASTERION-12-slug). The stamp is what
# check-work-branch.sh reads to tell whether a branch carries another ticket's
# commits, i.e. whether it was cut from another ticket branch instead of staging.

msg_file=$1
source=${2:-}

# Merges and squashes describe other commits; leave them alone.
case "$source" in merge|squash) exit 0 ;; esac

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
ticket=$(printf '%s' "$branch" | sed -nE 's#^(feature|fix|chore|hotfix)/([A-Z][A-Z0-9]*-[0-9]+)-.*#\2#p')
[ -n "$ticket" ] || exit 0

git interpret-trailers --in-place --if-exists doNothing --trailer "Plane: $ticket" "$msg_file"
